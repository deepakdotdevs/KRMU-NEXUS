<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.krmu.nexus.ui.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splash_to_roleSelection"
            app:destination="@id/roleSelectionFragment"/>
    <action
        android:id="@+id/action_splash_to_teacherDashboard"
        app:destination="@id/teacherDashboardFragment"/>
    <action
        android:id="@+id/action_splash_to_studentDashboard"
        app:destination="@id/studentDashboardFragment"/>
    </fragment>

    <fragment
        android:id="@+id/roleSelectionFragment"
        android:name="com.krmu.nexus.ui.role.RoleSelectionFragment"
        android:label="Role Selection"
        tools:layout="@layout/fragment_role_selection">
        <action
            android:id="@+id/action_roleSelection_to_studentLoginFragment"
            app:destination="@id/studentLoginFragment" />

        <action
            android:id="@+id/action_roleSelection_to_teacherLoginFragment"
            app:destination="@id/teacherLoginFragment" />

    </fragment>

    <fragment
        android:id="@+id/studentLoginFragment"
        android:name="com.krmu.nexus.ui.auth.StudentLoginFragment"
        android:label="Student Login"
        tools:layout="@layout/fragment_student_login">

        <action
            android:id="@+id/action_studentLoginFragment_to_studentDashboardFragment"
            app:destination="@id/studentDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/teacherLoginFragment"
        android:name="com.krmu.nexus.ui.auth.TeacherLoginFragment"
        android:label="Teacher Login"
        tools:layout="@layout/fragment_teacher_login">

        <action
            android:id="@+id/action_teacherLoginFragment_to_teacherDashboardFragment"
            app:destination="@id/teacherDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/teacherDashboardFragment"
        android:name="com.krmu.nexus.ui.teacher.TeacherDashboardFragment"
        android:label="Teacher Dashboard"
        tools:layout="@layout/fragment_teacher_dashboard"/>
    <fragment
        android:id="@+id/studentDashboardFragment"
        android:name="com.krmu.nexus.ui.student.StudentDashboardFragment"
        android:label="Student Dashboard"
        tools:layout="@layout/fragment_student_dashboard"/>
</navigation>