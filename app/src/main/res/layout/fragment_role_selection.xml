<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_roleselection">

    <ImageView
        android:id="@+id/RoleSelectionPNG"
        android:layout_width="354dp"
        android:layout_height="365dp"
        android:src="@drawable/education_illustration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.117" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/glacial_indifference_regular"
        android:text="Choose Your Role"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/RoleSelectionPNG" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTeacher"
        android:layout_width="287dp"
        android:layout_height="64dp"
        android:background="@drawable/ripple_teacher"

        android:elevation="6dp"
        android:fontFamily="@font/arapey_regular"
        android:text="Login as Teacher"
        android:textAllCaps="false"

        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.724"
        app:shapeAppearanceOverlay="@null"
        app:strokeColor="@null"
        app:strokeWidth="0dp" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/roleDivider"
        android:layout_width="170dp"
        android:layout_height="3dp"
        android:layout_marginVertical="8dp"
        app:dividerColor="#000000"
        app:layout_constraintBottom_toTopOf="@id/btnStudent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnTeacher"
        app:layout_constraintVertical_bias="0.521" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStudent"
        android:layout_width="287dp"
        android:layout_height="64dp"
        android:background="@drawable/ripple_student"

        android:elevation="6dp"
        android:fontFamily="@font/arapey_regular"
        android:text="Login as Student"
        android:textAllCaps="false"

        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.859"
        app:shapeAppearanceOverlay="@null"
        app:strokeColor="@null"
        app:strokeWidth="0dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/glacial_indifference_regular"
        android:text="Powered By DeepakDotDevs"
        android:textColor="#434242"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.977" />
</androidx.constraintlayout.widget.ConstraintLayout>